// Cloudflare Worker configuration (ADR 0003).
//
// Top level = local development and the Vitest Workers pool (bindings are
// simulated locally by Miniflare). `env.test` and `env.live` are the two
// deployed copies, each with its own D1, R2 bucket and queue. Bindings are not
// inherited by environments, so each one declares its own.
//
// PLACEHOLDERS, to be replaced by a human before the first deploy (see
// docs/agents/conventions.md, "Deploying"):
//   - "bsh.example.com"        → the real custom domain
//   - "REPLACE_WITH_*_D1_ID"   → ids printed by `wrangler d1 create`
//   - "owner@example.com"      → the owner's Cloudflare Access email (OWNER_EMAIL)
//
// Secrets (never in this file; `wrangler secret put <NAME> --env test|live`):
//   - ICAL_FEED_TOKEN          → the iCal feed's token (/ical/<token>.ics); unset = feed off
//   - WORLD_TRIATHLON_API_KEY  → World Triathlon's API key
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belgian-sports-hub",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app lives on a custom domain only (an installed PWA is tied to its origin).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Static files (build/client) are served as named: the service worker precaches
  // offline.html and offline-curation.html by those exact URLs.
  "assets": { "html_handling": "none" },
  // OWNER_EMAIL: the one Cloudflare Access identity allowed into /curate (app/owner.ts).
  "vars": { "APP_ENV": "dev", "OWNER_EMAIL": "owner@localhost" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bsh-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "bsh-raw-dev" }],
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "bsh-ingest-dev" }],
    "consumers": [{ "queue": "bsh-ingest-dev", "max_batch_size": 1, "max_retries": 3 }]
  },
  "env": {
    // Test copy: deployed on every push to main; scheduled fetches OFF.
    "test": {
      "name": "belgian-sports-hub-test",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "test.bsh.example.com", "custom_domain": true }], // PLACEHOLDER domain
      "vars": { "APP_ENV": "test", "OWNER_EMAIL": "owner@example.com" }, // PLACEHOLDER owner email
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bsh-test",
          "database_id": "REPLACE_WITH_TEST_D1_ID", // PLACEHOLDER
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "RAW", "bucket_name": "bsh-raw-test" }],
      "queues": {
        "producers": [{ "binding": "INGEST", "queue": "bsh-ingest-test" }],
        "consumers": [{ "queue": "bsh-ingest-test", "max_batch_size": 1, "max_retries": 3 }]
      }
    },
    // Live copy: deployed by hand ("update app") through the Deploy live workflow.
    "live": {
      "name": "belgian-sports-hub",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "bsh.example.com", "custom_domain": true }], // PLACEHOLDER domain
      "vars": { "APP_ENV": "live", "OWNER_EMAIL": "owner@example.com" }, // PLACEHOLDER owner email
      // Daily ingest (the scheduled handler queues one job per due source) and the
      // weekly D1 export to R2 under backups/, last 12 kept (app/backup/weekly-backup.ts).
      "triggers": { "crons": ["0 4 * * *", "0 3 * * 1"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bsh-live",
          "database_id": "REPLACE_WITH_LIVE_D1_ID", // PLACEHOLDER
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "RAW", "bucket_name": "bsh-raw-live" }],
      "queues": {
        "producers": [{ "binding": "INGEST", "queue": "bsh-ingest-live" }],
        "consumers": [{ "queue": "bsh-ingest-live", "max_batch_size": 1, "max_retries": 3 }]
      }
    }
  }
}
